    "/notes/export": {
      "get": {
        "description": "Downloads one complete CSV of all notes or of a single tag, without pagination. Safe text rule: a title, body or tags cell whose first character after any leading whitespace or control characters is =, +, - or @ is exported with one leading apostrophe (') so spreadsheets do not treat it as a formula; other values are exported unchanged. Stored notes are not changed.",
        "operationId": "export-notes",
        "parameters": [
          {
            "description": "Repeat for each field; duplicate fields are exported once.",
            "in": "query",
            "name": "fields",
            "required": true,
            "schema": {
              "description": "Repeat for each field; duplicate fields are exported once.",
              "items": {
                "enum": [
                  "id",
                  "title",
                  "body",
                  "tags",
                  "created_at",
                  "updated_at"
                ],
                "type": "string"
              },
              "minItems": 1,
              "title": "Fields",
              "type": "array"
            }
          },
          {
            "description": "At most one tag; omitted or empty selects all notes.",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "At most one tag; omitted or empty selects all notes.",
              "title": "Tag"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/csv": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Complete UTF-8 CSV with selected headings; may have zero records.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "required": true,
                "schema": {
                  "const": "attachment; filename=\"notes.csv\"",
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Invalid field selection or repeated tag; no attachment."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportErrorResponse"
                }
              }
            },
            "description": "Export could not be completed; no attachment."
          }
        },
        "summary": "Export"
      }
    },
